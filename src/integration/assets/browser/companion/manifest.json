{
  "manifest_version": 3,
  "name": "herdr companion",
  "version": "0.10.0",
  "description": "Tab groups for herdr's agent panes. Driven by herdr over the DevTools port; nothing runs on its own.",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
