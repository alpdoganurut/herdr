{
  "about": "Link ops v1 (frozen): `ops` is every op and what A's gate does with it; `cases` are gate runs. `config` is A's (default allow_eval true, type_into_password_fields false). `expect` is one of: `forward` (what goes to the sidecar; path and inline_path never go on; missing args are none), `helper` (the helper answers), `refuse` (host_refused: the rule and what).",
  "link_ops": 1,
  "ops": [
    {"op": "hello", "gate": "helper"},
    {"op": "ping", "gate": "helper"},
    {"op": "attach", "gate": "refused"},
    {"op": "detach", "gate": "refused"},
    {"op": "close_browser", "gate": "refused"},
    {"op": "control_quit", "gate": "refused"},
    {"op": "dashboard", "gate": "refused"},
    {"op": "ntp", "gate": "refused"},
    {"op": "show", "gate": "refused"},
    {"op": "watch", "gate": "refused"},
    {"op": "unwatch", "gate": "refused"},
    {"op": "show_remote", "gate": "allowed", "driving": true, "args": [{"name": "tab_id", "kind": "text"}, {"name": "opened_by", "kind": "text"}, {"name": "token", "kind": "file_token", "required": true}, {"name": "rel", "kind": "rel_path", "required": true}, {"name": "title", "kind": "text"}, {"name": "focus", "kind": "bool"}]},
    {"op": "open", "gate": "allowed", "driving": true, "args": [{"name": "url", "kind": "web_url", "required": true}, {"name": "wait", "kind": "text"}, {"name": "background", "kind": "bool"}, {"name": "tab_id", "kind": "text"}, {"name": "opened_by", "kind": "text"}]},
    {"op": "navigate", "gate": "allowed", "driving": true, "target": true, "args": [{"name": "url", "kind": "web_url", "required": true}, {"name": "wait", "kind": "text"}]},
    {"op": "history", "gate": "allowed", "driving": true, "target": true, "args": [{"name": "action", "kind": {"one_of": ["back", "forward", "reload"]}, "required": true}]},
    {"op": "read", "gate": "allowed", "target": true, "args": [{"name": "format", "kind": "text"}, {"name": "selector", "kind": "text"}, {"name": "ref", "kind": "text"}, {"name": "interactive", "kind": "bool"}]},
    {"op": "links", "gate": "allowed", "target": true, "args": [{"name": "filter", "kind": "text"}, {"name": "max", "kind": "count"}]},
    {"op": "console", "gate": "allowed", "target": true, "args": [{"name": "level", "kind": "text"}, {"name": "since", "kind": "count"}, {"name": "max", "kind": "count"}]},
    {"op": "network", "gate": "allowed", "target": true, "args": [{"name": "failed", "kind": "bool"}, {"name": "match", "kind": "text"}, {"name": "type", "kind": "text"}, {"name": "since", "kind": "count"}, {"name": "max", "kind": "count"}]},
    {"op": "wait", "gate": "allowed", "target": true, "args": [{"name": "text", "kind": "text"}, {"name": "gone", "kind": "text"}, {"name": "selector", "kind": "text"}, {"name": "url", "kind": "text"}, {"name": "load", "kind": "text"}, {"name": "timeout_ms", "kind": "count"}]},
    {"op": "scroll", "gate": "allowed", "target": true, "args": [{"name": "to", "kind": "text"}, {"name": "by", "kind": "integer"}]},
    {"op": "tabs", "gate": "allowed"},
    {"op": "select", "gate": "allowed", "target": true},
    {"op": "close", "gate": "allowed", "driving": true, "target": true},
    {"op": "dialog", "gate": "allowed", "driving": true, "target": true, "args": [{"name": "accept", "kind": "bool"}, {"name": "text", "kind": "text"}]},
    {"op": "act", "gate": "allowed", "driving": true, "target": true, "args": [{"name": "kind", "kind": {"one_of": ["click", "hover", "fill", "select", "type", "press"]}, "required": true}, {"name": "ref", "kind": "text"}, {"name": "selector", "kind": "text"}, {"name": "text", "kind": "text"}, {"name": "submit", "kind": "bool"}, {"name": "clear", "kind": "bool"}, {"name": "value", "kind": "text"}, {"name": "key", "kind": "key"}, {"name": "allow_password", "kind": "own"}]},
    {"op": "eval", "gate": "allowed", "driving": true, "target": true, "args": [{"name": "expr", "kind": "eval_text", "required": true}, {"name": "guard_passwords", "kind": "own"}]},
    {"op": "screenshot", "gate": "allowed", "target": true, "args": [{"name": "full", "kind": "bool"}, {"name": "ref", "kind": "text"}, {"name": "selector", "kind": "text"}, {"name": "format", "kind": "text"}, {"name": "quality", "kind": "count"}, {"name": "max_px", "kind": "count"}, {"name": "path", "kind": "own"}, {"name": "inline_path", "kind": "own"}]},
    {"op": "focus", "gate": "allowed", "target": true, "args": [{"name": "user", "kind": "own"}]},
    {"op": "control_raise", "gate": "allowed", "args": [{"name": "user", "kind": "own"}]},
    {"op": "release", "gate": "allowed", "args": [{"name": "keys", "kind": "text_list"}]}
  ],
  "cases": [
    {"name": "the helper answers hello", "frame": {"t": "op", "id": 1, "echo": 1, "op": "hello", "deadline_ms": 30000}, "expect": {"helper": true}},
    {"name": "the helper answers ping", "frame": {"t": "op", "id": 2, "echo": 1, "op": "ping", "deadline_ms": 30000}, "expect": {"helper": true}},
    {"name": "attach is refused", "frame": {"t": "op", "id": 3, "echo": 1, "op": "attach", "args": {"port": 9222, "kind": "companion", "nonce": "x", "remote": false}, "deadline_ms": 30000}, "expect": {"refuse": {"rule": "local_op", "what": "attach"}}},
    {"name": "detach is refused", "frame": {"t": "op", "id": 4, "echo": 1, "op": "detach", "deadline_ms": 30000}, "expect": {"refuse": {"rule": "local_op", "what": "detach"}}},
    {"name": "close_browser is refused", "frame": {"t": "op", "id": 5, "echo": 1, "op": "close_browser", "deadline_ms": 30000}, "expect": {"refuse": {"rule": "local_op", "what": "close_browser"}}},
    {"name": "control_quit is refused", "frame": {"t": "op", "id": 6, "echo": 1, "op": "control_quit", "deadline_ms": 30000}, "expect": {"refuse": {"rule": "local_op", "what": "control_quit"}}},
    {"name": "dashboard is refused", "frame": {"t": "op", "id": 7, "echo": 1, "op": "dashboard", "deadline_ms": 30000}, "expect": {"refuse": {"rule": "local_op", "what": "dashboard"}}},
    {"name": "ntp is refused", "frame": {"t": "op", "id": 8, "echo": 1, "op": "ntp", "deadline_ms": 30000}, "expect": {"refuse": {"rule": "local_op", "what": "ntp"}}},
    {"name": "show is refused", "frame": {"t": "op", "id": 9, "echo": 1, "op": "show", "args": {"file": "/etc/hosts", "root": "/etc"}, "deadline_ms": 30000}, "expect": {"refuse": {"rule": "local_op", "what": "show"}}},
    {"name": "watch is refused", "frame": {"t": "op", "id": 10, "echo": 1, "op": "watch", "target": "9A1F", "args": {"file": "/etc/hosts"}, "deadline_ms": 30000}, "expect": {"refuse": {"rule": "local_op", "what": "watch"}}},
    {"name": "unwatch is refused", "frame": {"t": "op", "id": 11, "echo": 1, "op": "unwatch", "target": "9A1F", "deadline_ms": 30000}, "expect": {"refuse": {"rule": "local_op", "what": "unwatch"}}},
    {"name": "an unknown op", "frame": {"t": "op", "id": 12, "echo": 1, "op": "set_input_files", "target": "9A1F", "args": {"paths": ["/etc/hosts"]}, "deadline_ms": 30000}, "expect": {"refuse": {"rule": "unknown_op", "what": "set_input_files"}}},
    {"name": "an op name is exact", "frame": {"t": "op", "id": 13, "echo": 1, "op": "Tabs", "deadline_ms": 30000}, "expect": {"refuse": {"rule": "unknown_op", "what": "Tabs"}}},
    {"name": "an op name's control characters are stripped", "frame": {"t": "op", "id": 14, "echo": 1, "op": "a\u001b[31mb", "deadline_ms": 30000}, "expect": {"refuse": {"rule": "unknown_op", "what": "a[31mb"}}},
    {"name": "tabs without arguments", "frame": {"t": "op", "id": 15, "echo": 1, "op": "tabs", "deadline_ms": 30000}, "expect": {"forward": {"op": "tabs"}}},
    {"name": "tabs drops what it does not know", "frame": {"t": "op", "id": 16, "echo": 1, "op": "tabs", "args": {"all": true}, "deadline_ms": 30000}, "expect": {"forward": {"op": "tabs"}}},
    {"name": "arguments that are no object", "frame": {"t": "op", "id": 17, "echo": 1, "op": "tabs", "args": ["x"], "deadline_ms": 30000}, "expect": {"refuse": {"rule": "argument", "what": "tabs args"}}},
    {"name": "open as the hub sends it", "frame": {"t": "op", "id": 18, "echo": 1, "op": "open", "args": {"url": "https://example.com/", "background": true, "wait": null, "tab_id": "w2:t3", "opened_by": "agent:w2:p7"}, "deadline_ms": 30000}, "expect": {"forward": {"op": "open", "args": {"url": "https://example.com/", "background": true, "tab_id": "w2:t3", "opened_by": "agent:w2:p7"}}}},
    {"name": "open on a page of the remote machine", "frame": {"t": "op", "id": 19, "echo": 1, "op": "open", "args": {"url": "http://localhost:3000/a?b#c", "background": true, "wait": "load", "tab_id": null, "opened_by": null}, "deadline_ms": 30000}, "expect": {"forward": {"op": "open", "args": {"url": "http://localhost:3000/a?b#c", "background": true, "wait": "load"}}}},
    {"name": "open a blank page", "frame": {"t": "op", "id": 20, "echo": 1, "op": "open", "args": {"url": "about:blank"}, "deadline_ms": 30000}, "expect": {"forward": {"op": "open", "args": {"url": "about:blank"}}}},
    {"name": "a scheme has no case", "frame": {"t": "op", "id": 21, "echo": 1, "op": "open", "args": {"url": "HTTPS://example.com/"}, "deadline_ms": 30000}, "expect": {"forward": {"op": "open", "args": {"url": "HTTPS://example.com/"}}}},
