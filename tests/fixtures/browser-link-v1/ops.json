    {"name": "open refuses 'FILE:///etc/hosts'", "frame": {"t": "op", "id": 23, "echo": 1, "op": "open", "args": {"url": "FILE:///etc/hosts"}, "deadline_ms": 30000}, "expect": {"refuse": {"rule": "url", "what": "open url"}}},
